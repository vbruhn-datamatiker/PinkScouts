@page
@model PinkScouts.Pages.ActivitiesModel
@{
}

<!-- === Activities Page === -->

<!-- ==== Page header ==== -->
<section class="page-header">
    <h1 class="fw-bold">Aktiviteter</h1>
    <p class="lead mb-0">
        Aktiviteter for Spejderlejr i Hedeland 2027.
    </p>
</section>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-warning" role="alert">
        @Model.ErrorMessage
    </div>
}
else if (Model.Activities.Count == 0)
{
    <div class="empty-state text-center">
        <h2 class="h5">Ingen aktiviteter endnu</h2>
        <p class="mb-0">Der er ikke oprettet nogen aktiviteter.</p>
    </div>
}
else
{
    <p class="text-muted">@Model.Activities.Count aktiviteter</p>

    <div class="row g-4 pb-5">
        @foreach (var activity in Model.Activities)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card activity-card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">@activity.ActivityName</h2>
                        <p class="card-text">@activity.Description</p>
                        <a class="btn btn-primary" asp-page="/ActivityDetails" asp-route-id="@activity.Id">
                            Læs mere
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- === allow the user to create new activities === -->
<div class="container mt-4">
    <h2>Opret Ny Aktivitet</h2>
    <form method="post" asp-page-handler="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Aktivitetsnavn</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Opret aktivitet</button>
    </form>
</div>